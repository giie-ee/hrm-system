APP_ENV=local
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hrms
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/hrms
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MIGRATE_ON_START=1
SEED_ADMIN_ON_START=0
SEED_DASHBOARD_USERS_ON_START=0
ALLOW_DASHBOARD_TEST_SEED=0
SESSION_COOKIE_SECURE=0
HRMS_DOCUMENT_DIR=
# Generate a private 32-byte key and keep it outside source control.
HRMS_BANKING_ACTIVE_KEY_ID=local-development
HRMS_BANKING_KEYS_JSON=
